# Copy to backend/.env and fill in. Never commit the real .env.

# --- required ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/buysell?retryWrites=true&w=majority
# Long random string (>= 32 chars in production). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- optional ---
PORT=8000
NODE_ENV=development

# Comma-separated frontend origins allowed by CORS (dev defaults: localhost:5173, :5174)
CLIENT_ORIGIN=http://localhost:5173

# Separate key for encrypting delivery OTPs at rest (defaults to JWT_SECRET)
OTP_ENCRYPTION_KEY=

# Only these email domains may register (comma-separated)
ALLOWED_EMAIL_DOMAINS=iiit.ac.in,students.iiit.ac.in,research.iiit.ac.in

# IIIT CAS single sign-on. The frontend's VITE_CAS_CALLBACK must be listed here.
CAS_URL=https://login.iiit.ac.in/cas
CAS_ALLOWED_SERVICES=http://localhost:5173/cas-callback

# Cookie SameSite: lax (default) | strict | none (none requires HTTPS)
COOKIE_SAMESITE=lax
# Set to true when running behind a reverse proxy (so rate limiting sees real IPs)
TRUST_PROXY=false
