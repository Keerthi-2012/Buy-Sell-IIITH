# Copy to frontend/.env

# API base. Leave unset in dev to use the Vite proxy (/api -> localhost:8000)
# and in production when the backend serves the built frontend.
# VITE_API_BASE_URL=http://localhost:8000/api/v1

# IIIT CAS: where CAS sends the user back (must match CAS_ALLOWED_SERVICES in backend/.env)
VITE_CAS_CALLBACK=http://localhost:5173/cas-callback

# Where to land after CAS logout
VITE_CLIENT_BASE_URL=http://localhost:5173
